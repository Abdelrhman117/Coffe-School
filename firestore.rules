rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    // Authenticated user
    function isAuth() {
      return request.auth != null;
    }

    // The requesting user owns the document
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Admin check — users with role == 'admin' in their user doc
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Field is unchanged between writes (used to lock immutable fields)
    function notChanging(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == resource.data[field];
    }

    // ── /products ─────────────────────────────────────────────────────────────
    // Anyone can read products; only admins can write.
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() &&
        request.resource.data.keys().hasAll(['name', 'price', 'type']) &&
        request.resource.data.price is number &&
        request.resource.data.price > 0;
      allow update: if isAdmin() &&
        notChanging('createdAt');
      allow delete: if isAdmin();
    }

    // ── /orders ───────────────────────────────────────────────────────────────
    // Users can create their own orders and read their own orders.
    // Admins can read all orders and update status.
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();

      allow create: if isAuth() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasAll(['uid', 'items', 'total', 'status']) &&
        request.resource.data.total is number &&
        request.resource.data.total > 0 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0;

      // Only admins can update order status; uid and items are immutable
      allow update: if isAdmin() &&
        notChanging('uid') &&
        notChanging('items') &&
        notChanging('total');

      allow delete: if isAdmin();
    }

    // ── /users ────────────────────────────────────────────────────────────────
    // Users can read and update their own profile.
    // Role field can only be set by admins.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Self-create on signup — role is always 'user' on creation
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.uid == userId;

      // Self-update — cannot elevate own role
      allow update: if isOwner(userId) &&
        notChanging('role') &&
        notChanging('uid') &&
        notChanging('createdAt');

      // Admin can update any user (including role)
      allow update: if isAdmin() && notChanging('uid');

      allow delete: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
